{
  "name": "penta",
  "version": "1.0.0",
  "private": true,
  "description": "Penta: Truf, Hearts, Sevens, Trumpon and Capsa over four rounds, online with friends",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "host": "tsx server/host.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "cloudflared": "^0.7.3",
    "koa-static": "^5.0.0",
    "node-persist": "^3.1.3",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
